{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPATREN Desktop",
  "version": "1.0.0",
  "identifier": "lk.spatren.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SPATREN Desktop", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "dragDropEnabled": true }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/library/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "bin/*": "bin/" },
    "category": "Education",
    "shortDescription": "Field recordings to transcripts, offline"
  }
}
